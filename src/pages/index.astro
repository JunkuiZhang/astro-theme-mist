---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
const categories = [...new Set(posts.map(p => p.data.category))];
const primaryCategories = ['学习', '教程', '随笔'].filter(c => categories.includes(c));
---
<BaseLayout>
  <header class="home-heading">
    <h1><span>{siteConfig.title}</span><svg class="heading-flower" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 15C5-5 0 13 12 20-5 28 10 41 20 28c10 13 25 0 8-8C40 13 35-5 20 15Z" /><circle cx="20" cy="21" r="4" /></svg></h1>
  </header>
  <section class="journal" aria-labelledby="journal-heading" data-journal>
    <h2 id="journal-heading" class="sr-only">文章</h2>
    <div class="journal-controls">
      <div class="filter-bar" aria-label="按分类筛选"><button class="filter-button active" data-filter="" aria-pressed="true">全部 <span>{posts.length}</span></button>{primaryCategories.map(category => <button class="filter-button" data-filter={category} aria-pressed="false">{category}</button>)}</div>
      <div class="view-controls"><button class="icon-button selected" data-view="grid" aria-label="网格视图" aria-pressed="true"><Icon name="grid" size={17} /></button><button class="icon-button" data-view="list" aria-label="列表视图" aria-pressed="false"><Icon name="list" size={19} /></button></div>
    </div>
    <p id="filter-status" class="sr-only" aria-live="polite"></p>
    <div class="post-grid" id="post-grid">{posts.map(post => <PostCard post={post} />)}</div>
    <div class="load-more-wrap"><div id="load-sentinel" aria-hidden="true" hidden></div><button class="load-more" id="load-more" hidden>加载更多 <Icon name="arrow" size={17} /></button><p id="list-end" hidden>已显示全部文章</p></div>
  </section>
</BaseLayout>
