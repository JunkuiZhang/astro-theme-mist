---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config';
import { url } from '../lib/posts';
---
<BaseLayout title="关于" active="about">
  <header class="page-heading"><h1>关于</h1></header>
  <section class="about-panel">
    <img class="about-portrait" src={url(siteConfig.avatar)} width="80" height="80" alt={`${siteConfig.author}的头像`} />
    <div class="about-details"><h2>{siteConfig.author}</h2><p>{siteConfig.bio}</p><div class="about-links"><a class="solid-button" href={siteConfig.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /> GitHub</a><a class="text-link" href={url('rss.xml')}><Icon name="rss" size={17} /> RSS</a></div><p id="theme" class="theme-credit">主题：{siteConfig.themeName}</p></div>
  </section>
</BaseLayout>
